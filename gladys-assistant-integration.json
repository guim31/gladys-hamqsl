{
  "manifest_version": 1,
  "type": "device",
  "name": "HamQSL",
  "description": {
    "en": "HF and VHF radio propagation for hams: solar flux, K index, band conditions, by N0NBH (HamQSL).",
    "fr": "Propagation radio HF et VHF pour radioamateurs : flux solaire, indice K, état des bandes (N0NBH).",
    "de": "KW- und UKW-Ausbreitung für Funkamateure: solarer Flux, K-Index, Bandzustände (N0NBH, HamQSL).",
    "es": "Propagación de radio HF y VHF para radioaficionados: flujo solar, índice K, bandas (N0NBH)."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-hamqsl:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-hamqsl/main/cover.png",
  "categories": ["environment", "services"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "HF propagation",
        "fr": "Propagation HF",
        "de": "KW-Ausbreitung",
        "es": "Propagación HF"
      },
      "description": {
        "en": "Reads the public solar data feed of N0NBH (HamQSL), without an account: solar flux, sunspots, K and A indices, X-rays, solar wind and the HF band conditions by day and by night. Save, then create the device in the Discover tab.",
        "fr": "Lit le flux public de données solaires de N0NBH (HamQSL), sans compte : flux solaire, taches, indices K et A, rayons X, vent solaire et l'état des bandes HF de jour et de nuit. Enregistrez, puis créez l'appareil dans l'onglet Découverte.",
        "de": "Liest den öffentlichen Sonnendaten-Feed von N0NBH (HamQSL), ohne Konto: solarer Flux, Sonnenflecken, K- und A-Index, Röntgenstrahlung, Sonnenwind und die KW-Bandzustände bei Tag und Nacht. Speichere und lege dann das Gerät im Tab „Entdecken“ an.",
        "es": "Lee el feed público de datos solares de N0NBH (HamQSL), sin cuenta: flujo solar, manchas, índices K y A, rayos X, viento solar y el estado de las bandas HF de día y de noche. Guarde y cree el dispositivo en la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-hamqsl/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "about",
      "type": "section",
      "label": {
        "en": "Source",
        "fr": "Source",
        "de": "Quelle",
        "es": "Fuente"
      },
      "description": {
        "en": "Solar-terrestrial data courtesy of Paul Herrman, N0NBH (hamqsl.com). The band conditions are computed by N0NBH for the whole globe, not for your location. Not affiliated with HamQSL.",
        "fr": "Données solaires et terrestres offertes par Paul Herrman, N0NBH (hamqsl.com). L'état des bandes est calculé par N0NBH pour le globe entier, pas pour votre position. Non affiliée à HamQSL.",
        "de": "Sonnen- und Erddaten mit freundlicher Genehmigung von Paul Herrman, N0NBH (hamqsl.com). Die Bandzustände berechnet N0NBH für den ganzen Globus, nicht für deinen Standort. Nicht mit HamQSL verbunden.",
        "es": "Datos solares y terrestres por cortesía de Paul Herrman, N0NBH (hamqsl.com). N0NBH calcula el estado de las bandas para todo el globo, no para su ubicación. Sin afiliación con HamQSL."
      },
      "links": [
        {
          "url": "https://www.hamqsl.com/solar.html",
          "label": {
            "en": "HamQSL solar data",
            "fr": "Données solaires HamQSL",
            "de": "HamQSL-Sonnendaten",
            "es": "Datos solares de HamQSL"
          }
        }
      ]
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Fréquence de mise à jour",
        "de": "Aktualisierungsintervall",
        "es": "Frecuencia de actualización"
      },
      "description": {
        "en": "N0NBH updates the feed about once an hour, and asks not to read it more often than every 30 minutes.",
        "fr": "N0NBH met le flux à jour environ une fois par heure, et demande de ne pas le lire plus souvent que toutes les 30 minutes.",
        "de": "N0NBH aktualisiert den Feed etwa einmal pro Stunde und bittet, ihn höchstens alle 30 Minuten zu lesen.",
        "es": "N0NBH actualiza el feed aproximadamente una vez por hora y pide no leerlo con más frecuencia que cada 30 minutos."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "30",
          "label": {
            "en": "30 minutes",
            "fr": "30 minutes",
            "de": "30 Minuten",
            "es": "30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 hour",
            "fr": "1 heure",
            "de": "1 Stunde",
            "es": "1 hora"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 hours",
            "fr": "2 heures",
            "de": "2 Stunden",
            "es": "2 horas"
          }
        },
        {
          "value": "180",
          "label": {
            "en": "3 hours",
            "fr": "3 heures",
            "de": "3 Stunden",
            "es": "3 horas"
          }
        }
      ]
    },
